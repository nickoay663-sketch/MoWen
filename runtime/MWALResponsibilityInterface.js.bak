import MWALContract from "./MWALContract.js";

/**
 * MoWen Accountability Layer
 * Responsibility Interface v2.1
 *
 * Purpose:
 * Convert the normalized responsibility records carried by
 * ResponsibilityEvent into the MWAL responsibility envelope.
 *
 * Core rule:
 *
 *     Translate responsibility facts.
 *     Do not manufacture responsibility facts.
 *
 * This interface does not:
 * - create evidence
 * - verify facts
 * - infer human identity
 * - infer responsibility
 * - assign legal responsibility
 * - manufacture signatures
 * - manufacture event identifiers
 * - authorize propagation
 * - export Runtime internals
 *
 * Runtime objects such as:
 * - semanticObject
 * - engineRegistry
 * - engines
 * - runtimeContext
 *
 * are explicitly excluded from the MWAL boundary.
 */

class MWALResponsibilityInterface {

    static VERSION = "2.1";

    static NAME =
        "MWALResponsibilityInterface";


    /*
     * =========================================================
     * Verification State Mapping
     * =========================================================
     *
     * This is a translation only.
     *
     * No state is upgraded during mapping.
     */

    static mapVerificationState(
        epistemicState
    ) {

        const state =
            epistemicState || "UNKNOWN";

        const map = {

            DISCOVERED:
                MWALContract.VERIFICATION_STATES.DISCOVERED,

            UNVERIFIED:
                MWALContract.VERIFICATION_STATES.UNVERIFIED,

            VERIFIED:
                MWALContract.VERIFICATION_STATES.VERIFIED,

            SUPPORTED:
                MWALContract.VERIFICATION_STATES.SUPPORTED,

            CONTRADICTED:
                MWALContract.VERIFICATION_STATES.CONTRADICTED,

            UNKNOWN:
                MWALContract.VERIFICATION_STATES.UNKNOWN

        };

        return (
            map[state] ||
            MWALContract.VERIFICATION_STATES.UNKNOWN
        );

    }


    /*
     * =========================================================
     * Responsibility State Mapping
     * =========================================================
     *
     * Responsibility state is derived only from the explicit
     * responsibility record.
     *
     * No responsibility may be upgraded merely because a
     * ResponsibilityEvent exists.
     */

    static mapResponsibilityState(
        responsibilityRecord
    ) {

        const record =
            responsibilityRecord || {};

        if (
            record.responsibilityState &&
            Object.values(
                MWALContract.RESPONSIBILITY_STATES
            ).includes(
                record.responsibilityState
            )
        ) {

            return record.responsibilityState;

        }

        if (
            record.responsibilityBoundary?.status ===
            "exceeded"
        ) {

            return (
                MWALContract
                    .RESPONSIBILITY_STATES
                    .UNESTABLISHED
            );

        }

        if (
            record.responsibilityJudgment?.gap ===
            true
        ) {

            return (
                MWALContract
                    .RESPONSIBILITY_STATES
                    .UNESTABLISHED
            );

        }

        if (
            record.supported === true &&
            record.verificationStatus ===
                MWALContract.VERIFICATION_STATES.SUPPORTED
        ) {

            return (
                MWALContract
                    .RESPONSIBILITY_STATES
                    .ESTABLISHED
            );

        }

        return (
            MWALContract
                .RESPONSIBILITY_STATES
                .UNKNOWN
        );

    }


    /*
     * =========================================================
     * Propagation State Mapping
     * =========================================================
     *
     * Propagation is never authorized by this interface.
     *
     * If the event explicitly carries a valid propagation state,
     * it may be preserved.
     *
     * Otherwise REQUIRE_VERIFICATION remains mandatory.
     */

    static mapPropagationState(
        responsibilityEvent,
        responsibilityRecord
    ) {

        const event =
            responsibilityEvent || {};

        const explicit =
            event.propagationState;

        const validStates =
            Object.values(
                MWALContract.PROPAGATION_STATES
            );

        if (
            validStates.includes(explicit)
        ) {

            return explicit;

        }

        /*
         * A responsibility boundary exceeded or unresolved
         * capacity gap can never silently enter propagation.
         */

        if (
            responsibilityRecord?.responsibilityBoundary?.status ===
                "exceeded" ||
            responsibilityRecord?.responsibilityJudgment?.gap ===
                true
        ) {

            return (
                MWALContract
                    .PROPAGATION_STATES
                    .REQUIRE_VERIFICATION
            );

        }

        return (
            MWALContract
                .PROPAGATION_STATES
                .REQUIRE_VERIFICATION
        );

    }


    /*
     * =========================================================
     * Responsibility Record Extraction
     * =========================================================
     *
     * IMPORTANT:
     *
     * Only normalized responsibility records may cross the
     * MWAL boundary.
     *
     * The complete ResponsibilityEngine result is rejected
     * from direct propagation into MWAL.
     */

    static extractResponsibilityRecords(
        responsibilityEvent
    ) {

        const event =
            responsibilityEvent || {};

        if (
            Array.isArray(
                event.responsibilityRecords
            )
        ) {

            return event.responsibilityRecords
                .filter(
                    record =>
                        record &&
                        typeof record ===
                            "object"
                );

        }

        /*
         * Compatibility path:
         *
         * ResponsibilityEvent v1.1 exposes responsibilityRecords,
         * but older event objects may not.
         *
         * Only the explicit responsibilities array is accepted.
         */

        if (
            Array.isArray(
                event.responsibility?.responsibilities
            )
        ) {

            return event.responsibility.responsibilities
                .filter(
                    record =>
                        record &&
                        typeof record ===
                            "object"
                );

        }

        return [];

    }


    /*
     * =========================================================
     * Responsibility Projection
     * =========================================================
     *
     * This method deliberately creates a new plain object.
     *
     * It does NOT pass through:
     * - semanticObject
     * - engineRegistry
     * - engines
     * - runtimeContext
     * - metadata
     * - Engine instances
     */

    static projectResponsibility(
        responsibilityRecord
    ) {

        const record =
            responsibilityRecord || {};

        return {

            subject:
                record.responsibilityActor ||
                null,

            scope:
                record.responsibilityScope ||
                null,

            basis: {

                expression:
                    record.expression ||
                    null,

                definition:
                    record.definition ||
                    null,

                epistemicState:
                    record.epistemicState ||
                    "UNKNOWN",

                supported:
                    record.supported === true,

                evidenceCount:
                    Number.isFinite(
                        record.evidenceCount
                    )
                        ? record.evidenceCount
                        : 0,

                verifiedEvidenceCount:
                    Number.isFinite(
                        record.verifiedEvidenceCount
                    )
                        ? record.verifiedEvidenceCount
                        : 0,

                sourceCount:
                    Number.isFinite(
                        record.sourceCount
                    )
                        ? record.sourceCount
                        : 0,

                verifiedSourceCount:
                    Number.isFinite(
                        record.verifiedSourceCount
                    )
                        ? record.verifiedSourceCount
                        : 0,

                verificationStatus:
                    record.verificationStatus ||
                    "UNKNOWN"

            },

            limitations: {

                responsibilityDemand:
                    record.responsibilityDemand ||
                    null,

                responsibilityCapacity:
                    record.responsibilityCapacity ||
                    null,

                responsibilityBoundary:
                    record.responsibilityBoundary ||
                    null,

                responsibilityJudgment:
                    record.responsibilityJudgment ||
                    null,

                expressionResponsibility:
                    record.expressionResponsibility ||
                    null,

                evidenceResponsibility:
                    record.evidenceResponsibility ||
                    null,

                sourceResponsibility:
                    record.sourceResponsibility ||
                    null,

                verificationResponsibility:
                    record.verificationResponsibility ||
                    null

            }

        };

    }


    /*
     * =========================================================
     * MWAL Envelope Construction
     * =========================================================
     */

    static fromResponsibilityEvent(
        responsibilityEvent = {}
    ) {

        const event =
            responsibilityEvent || {};

        const records =
            MWALResponsibilityInterface
                .extractResponsibilityRecords(
                    event
                );

        const primaryRecord =
            records[0] || null;

        const verificationState =
            MWALResponsibilityInterface
                .mapVerificationState(
                    primaryRecord?.epistemicState ||
                    event.epistemicState
                );

        const responsibilityState =
            MWALResponsibilityInterface
                .mapResponsibilityState(
                    primaryRecord
                );

        const propagationState =
            MWALResponsibilityInterface
                .mapPropagationState(
                    event,
                    primaryRecord
                );

        const projectedResponsibility =
            primaryRecord
                ? MWALResponsibilityInterface
                    .projectResponsibility(
                        primaryRecord
                    )
                : null;

        return MWALContract.createEnvelope({

            eventId:
                event.eventId ||
                null,

            expression:
                event.expression ||
                primaryRecord?.expression ||
                null,

            identity:
                event.identity ||
                primaryRecord?.responsibilityActor?.identity ||
                null,

            timestamp:
                event.timestamp ||
                event.createdAt ||
                null,

            verificationState,

            responsibilityState,

            responsibility:
                projectedResponsibility,

            propagationState,

            evidence:
                Array.isArray(event.evidence)
                    ? event.evidence
                    : [],

            auditTrail:
                Array.isArray(event.auditTrail)
                    ? event.auditTrail
                    : [],

            signature:
                event.signature ||
                null,

            runtimeVersion:
                event.runtimeVersion ||
                null,

            contractVersion:
                event.contractVersion ||
                MWALContract.VERSION

        });

    }


    /*
     * =========================================================
     * Build + Validate
     * =========================================================
     */

    static buildValidatedEnvelope(
        responsibilityEvent = {}
    ) {

        const envelope =
            MWALResponsibilityInterface
                .fromResponsibilityEvent(
                    responsibilityEvent
                );

        const validation =
            MWALResponsibilityInterface
                .validate(
                    envelope
                );

        return {

            envelope,

            validation,

            valid:
                validation.valid === true

        };

    }


    /*
     * =========================================================
     * Structural Validation
     * =========================================================
     */

    static validate(
        mwalEnvelope = {}
    ) {

        return MWALContract.validate(
            mwalEnvelope
        );

    }


    /*
     * =========================================================
     * Propagation
     * =========================================================
     */

    static canPropagate(
        mwalEnvelope = {}
    ) {

        return MWALContract.canPropagate(
            mwalEnvelope
        );

    }


    static requiresVerification(
        mwalEnvelope = {}
    ) {

        return MWALContract.requiresVerification(
            mwalEnvelope
        );

    }


    /*
     * =========================================================
     * Interface Contract
     * =========================================================
     */

    static contract() {

        return Object.freeze({

            name:
                MWALResponsibilityInterface.NAME,

            version:
                MWALResponsibilityInterface.VERSION,

            contract:
                MWALContract.IDENTIFIER,

            contractVersion:
                MWALContract.VERSION,

            purpose:
                "Translate normalized ResponsibilityEvent records into an MWAL accountability envelope without exporting Runtime internals or manufacturing responsibility facts.",

            principles: Object.freeze([

                "TRANSLATION_NOT_INFERENCE",

                "NORMALIZED_RECORDS_ONLY",

                "NO_RUNTIME_INTERNAL_EXPORT",

                "NO_IDENTITY_INFERENCE",

                "NO_RESPONSIBILITY_INFERENCE",

                "NO_EVIDENCE_CREATION",

                "NO_FACTUAL_VERIFICATION",

                "NO_SIGNATURE_MANUFACTURE",

                "NO_EVENT_ID_MANUFACTURE",

                "NO_PROPAGATION_AUTHORIZATION_INFERENCE",

                "NO_LEGAL_JUDGMENT",

                "UNKNOWN_MUST_REMAIN_EXPLICIT"

            ]),

            excludedRuntimeFields: Object.freeze([

                "semanticObject",

                "engineRegistry",

                "engines",

                "runtimeContext",

                "metadata",

                "trace",

                "nextRuntimeState"

            ]),

            invariants:
                MWALContract.invariants()

        });

    }

}

export default MWALResponsibilityInterface;
